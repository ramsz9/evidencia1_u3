# Copiar a .env y poner valores reales (.env no se sube al repositorio)

# Dominio público de la VM (en local: localhost)
DOMAIN=localhost

# IP del host donde se publican 80 y 443 (en local: 127.0.0.1; en la VM: 0.0.0.0)
HOST_IP=127.0.0.1

POSTGRES_PASSWORD=TU_PASSWORD_DE_POSTGRES

# Genera uno con: head -c 32 /dev/urandom | base64
JWT_SECRET=TU_SECRETO_BASE64_DE_32_BYTES_O_MAS
